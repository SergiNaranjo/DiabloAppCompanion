<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1A0F0A">

    <!-- SCROLL PRINCIPAL -->
    <ScrollView
        android:id="@+id/scrollContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/bottomBar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingTop="40dp">

            <!-- HERO NAME -->
            <TextView
                android:id="@+id/txtHeroName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="HERO:\nNAME2"
                android:textAlignment="center"
                android:textSize="26sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:layout_marginBottom="20dp"/>

            <!-- INVENTORY / STATS GRID CON MARCO ROJO -->
            <LinearLayout
                android:id="@+id/inventoryBox"
                android:layout_width="240dp"
                android:layout_height="410dp"
                android:gravity="center"
                android:padding="10dp"
                android:layout_marginBottom="20dp">

                <GridLayout
                    android:id="@+id/gridItems"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:columnCount="3"
                    android:rowCount="5"
                    android:alignmentMode="alignMargins"
                    android:useDefaultMargins="true">

                    <!-- FILA 1 -->
                    <ImageView
                        android:layout_width="70dp"
                        android:layout_height="70dp"
                        android:src="@tools:sample/avatars"
                        android:padding="8dp"
                        android:scaleType="centerInside"/>

                    <ImageView
                        android:layout_width="70dp"
                        android:layout_height="70dp"
                        android:src="@tools:sample/avatars"
                        android:padding="8dp"
                        android:scaleType="centerInside"/>

                    <ImageView
                        android:layout_width="70dp"
                        android:layout_height="70dp"
                        android:src="@tools:sample/avatars"
                        android:padding="8dp"
                        android:scaleType="centerInside"/>

                    <!-- FILA 2 -->
                    <ImageView
                        android:layout_width="70dp"
                        android:layout_height="70dp"
                        android:src="@tools:sample/avatars"
                        android:padding="8dp"
                        android:scaleType="centerInside"/>

                    <ImageView
                        android:layout_width="70dp"
                        android:layout_height="70dp"
                        android:src="@tools:sample/avatars"
                        android:padding="8dp"
                        android:scaleType="centerInside"/>

                    <ImageView
                        android:layout_width="70dp"
                        android:layout_height="70dp"
                        android:src="@tools:sample/avatars"
                        android:padding="8dp"
                        android:scaleType="centerInside"/>

                    <!-- FILA 3 -->
                    <ImageView
                        android:layout_width="70dp"
                        android:layout_height="70dp"
                        android:src="@tools:sample/avatars"
                        android:padding="8dp"
                        android:scaleType="centerInside"/>

                    <ImageView
                        android:layout_width="70dp"
                        android:layout_height="70dp"
                        android:src="@tools:sample/avatars"
                        android:padding="8dp"
                        android:scaleType="centerInside"/>

                    <ImageView
                        android:layout_width="70dp"
                        android:layout_height="70dp"
                        android:src="@tools:sample/avatars"
                        android:padding="8dp"
                        android:scaleType="centerInside"/>

                    <!-- FILA 4 -->
                    <ImageView
                        android:layout_width="70dp"
                        android:layout_height="70dp"
                        android:src="@tools:sample/avatars"
                        android:padding="8dp"
                        android:scaleType="centerInside"/>

                    <ImageView
                        android:layout_width="70dp"
                        android:layout_height="70dp"
                        android:src="@tools:sample/avatars"
                        android:padding="8dp"
                        android:scaleType="centerInside"/>

                    <ImageView
                        android:layout_width="70dp"
                        android:layout_height="70dp"
                        android:src="@tools:sample/avatars"
                        android:padding="8dp"
                        android:scaleType="centerInside"/>

                    <!-- FILA 5 -->
                    <ImageView
                        android:layout_width="70dp"
                        android:layout_height="70dp"
                        android:padding="8dp"
                        android:scaleType="centerInside"/>

                    <ImageView
                        android:layout_width="70dp"
                        android:layout_height="70dp"
                        android:src="@tools:sample/avatars"
                        android:padding="8dp"
                        android:scaleType="centerInside"/>

                    <ImageView
                        android:layout_width="70dp"
                        android:layout_height="70dp"
                        android:padding="8dp"
                        android:scaleType="centerInside"/>

                </GridLayout>

            </LinearLayout>

            <!-- DAMAGE -->
            <TextView
                android:id="@+id/txtDamage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DAMAGE: 5230"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:layout_marginBottom="18dp"/>

            <!-- STATS BOX -->
            <LinearLayout
                android:id="@+id/statsBox"
                android:orientation="vertical"
                android:layout_width="240dp"
                android:layout_height="wrap_content"
                android:padding="10dp"
                android:layout_marginBottom="40dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="LEVEL:              5"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:layout_marginBottom="4dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="STRENGHT:        2"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:layout_marginBottom="4dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="DEXTERITY:      1"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:layout_marginBottom="4dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="INTELLIGENCE: 5"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:layout_marginBottom="4dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="VITALITY:          4"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"/>

            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- BOTTOM BAR -->
    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:gravity="center"
        android:background="#333"
        android:orientation="horizontal"
        android:layout_alignParentBottom="true">

        <ImageButton
            android:id="@+id/btnNews"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:src="@drawable/ic_launcher_foreground"
            android:padding="14dp"
            android:contentDescription="News" />

        <ImageButton
            android:id="@+id/btnInfo"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:src="@drawable/ic_launcher_foreground"
            android:padding="14dp"
            android:contentDescription="Info" />

        <ImageButton
            android:id="@+id/btnProfile"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:src="@drawable/ic_launcher_foreground"
            android:padding="14dp"
            android:backgroundTint="#CC0000"
            android:contentDescription="Profile" />
    </LinearLayout>

</RelativeLayout>

