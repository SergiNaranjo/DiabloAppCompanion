<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/ic_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:layout_margin="20dp">

    <Space
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_weight="0.7"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_weight="0.8"
        android:text="@string/title"
        android:textColor="@color/white"/>


    <EditText
        android:id="@+id/new_post_title"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_weight="0.7"
        android:inputType="text"
        android:textColor="@color/white"/>

    <Space
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_weight="0.8"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_weight="0.8"
        android:text="@string/description"
        android:textColor="@color/white"/>


    <EditText
        android:id="@+id/new_post_description"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_weight="0.7"
        android:inputType="text"
        android:textColor="@color/white"/>

    <Space
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_weight="0.8"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_weight="0.8"
        android:text="@string/url"
        android:textColor="@color/white"/>


    <EditText
        android:id="@+id/new_post_url"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_weight="0.7"
        android:inputType="textUri"
        android:textColor="@color/white"/>

    <Space
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_weight="0.8"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_weight="0.8"
        android:text="@string/image_url"
        android:textColor="@color/white"/>


    <EditText
        android:id="@+id/new_post_img_url"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_weight="0.7"
        android:inputType="textUri"
        android:textColor="@color/white"/>

    </LinearLayout>

    <ImageButton
        android:id="@+id/upload_post"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:layout_alignParentBottom="true"
        android:layout_alignParentEnd="true"
        android:padding="12dp"
        android:contentDescription="@string/content_description"
        android:elevation="8dp"
        android:background="@drawable/ic_btn_community_active"
        android:layout_marginStart="20dp"
        android:layout_marginBottom="50dp"/>

    <ImageButton
        android:id="@+id/exit_new_post"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:layout_alignParentTop="true"
        android:layout_alignParentStart="true"
        android:padding="12dp"
        android:contentDescription="@string/content_description"
        android:elevation="8dp"
        android:background="@drawable/ic_btn_news_deactive"
        android:layout_margin="20dp"/>

</RelativeLayout>