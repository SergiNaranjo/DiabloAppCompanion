<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center_horizontal"
    tools:ignore="MissingDefaultResource"
    android:background="#1A0F0A">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/bottomBar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/textView6"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Season 36 available"
                android:textStyle="bold"
                android:textSize="30dp"
                android:layout_marginBottom="12dp"
                android:gravity="center"
                android:textColor="#FFFFFF"/>

            <ImageView
                android:id="@+id/imageView7"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                app:srcCompat="@android:drawable/editbox_dropdown_light_frame"
                android:scaleType="centerCrop"
                android:layout_marginBottom="20dp" />

            <TextView
                android:id="@+id/textView7"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Featured Content"
                android:textStyle="bold"
                android:textSize="30dp"
                android:layout_marginBottom="12dp"
                android:gravity="center"
                android:textColor="#FFFFFF"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <androidx.fragment.app.FragmentContainerView
                    android:id="@+id/news_post_1"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"/>

                <androidx.fragment.app.FragmentContainerView
                    android:id="@+id/news_post_2"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"/>

                <androidx.fragment.app.FragmentContainerView
                    android:id="@+id/news_post_3"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"/>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- BOTTOM BAR -->
    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:gravity="center"
        android:background="#333"
        android:orientation="horizontal"
        android:layout_alignParentBottom="true">

        <ImageButton
            android:id="@+id/btnNews"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:src="@drawable/ic_launcher_foreground"
            android:padding="14dp"
            android:backgroundTint="#CC0000"
            android:contentDescription="News" />

        <ImageButton
            android:id="@+id/btnInfo"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:src="@drawable/ic_launcher_foreground"
            android:padding="14dp"
            android:contentDescription="Info" />

        <ImageButton
            android:id="@+id/btnProfile"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:src="@drawable/ic_launcher_foreground"
            android:padding="14dp"
            android:contentDescription="Profile" />

    </LinearLayout>


</RelativeLayout>

