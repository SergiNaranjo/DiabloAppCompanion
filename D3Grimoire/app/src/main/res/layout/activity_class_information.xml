<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/ic_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="20dp">

        <TextView
            android:id="@+id/class_name_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/class_name"
            android:textColor="@color/text_primary"
            android:textSize="34sp"
            android:textStyle="bold"
            android:layout_marginBottom="20dp"/>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="250dp"
            android:layout_marginBottom="32dp">

            <ImageView
                android:id="@+id/class_gif_background_image"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:alpha="0.5"
                tools:background="@color/surface_dark_alt" />

            <ImageView
                android:id="@+id/hero_portrait_image"
                android:layout_width="180dp"
                android:layout_height="220dp"
                android:layout_gravity="center"
                android:scaleType="centerCrop"
                android:background="@drawable/ic_template_classes"
                android:layout_marginBottom="16dp"/>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_gravity="bottom|start"
                android:layout_marginStart="8dp"
                android:layout_marginBottom="8dp">

                <ImageButton
                    android:id="@+id/male_button"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginBottom="8dp"
                    android:padding="8dp"
                    android:scaleType="centerInside"
                    android:contentDescription="@string/content_description_select_male"
                    android:background="@drawable/ic_btn_male_active"
                    />

                <ImageButton
                    android:id="@+id/female_button"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:padding="8dp"
                    android:background="@drawable/ic_btn_female_inactive"
                    android:scaleType="centerInside"
                    android:contentDescription="@string/content_description_select_female" />
            </LinearLayout>

        </FrameLayout>

        <TextView
            android:id="@+id/txtStrengthTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/primary_stat"
            android:textColor="@color/text_primary"
            android:textSize="26sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:id="@+id/txtStrengthDesc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/loading_class_description"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:gravity="center"
            android:layout_marginBottom="28dp"/>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/skills_recycler"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false"
            android:clipToPadding="false"
            android:paddingBottom="8dp" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
