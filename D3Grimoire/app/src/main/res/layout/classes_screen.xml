<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:paddingTop="32dp">

    <ScrollView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_above="@+id/bottomBar" >

    </ScrollView>

    <TextView
        android:id="@+id/txtClassesTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Classes"
        android:textSize="30dp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp"/>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <Button
            android:layout_width="250dp"
            android:layout_height="59dp"
            android:text="BARBARIAN"
            android:textColor="@android:color/white"
            android:textStyle="bold"
            android:layout_marginBottom="12dp"/>

        <Button
            android:layout_width="250dp"
            android:layout_height="59dp"
            android:text="CRUSADER"
            android:textColor="@android:color/white"
            android:textStyle="bold"
            android:layout_marginBottom="12dp"/>

        <Button
            android:layout_width="250dp"
            android:layout_height="59dp"
            android:text="DEMON HUNTER"
            android:textColor="@android:color/white"
            android:textStyle="bold"
            android:layout_marginBottom="12dp"/>

        <Button
            android:layout_width="250dp"
            android:layout_height="59dp"
            android:text="MONK"
            android:textColor="@android:color/white"
            android:textStyle="bold"
            android:layout_marginBottom="12dp"/>

        <Button
            android:layout_width="250dp"
            android:layout_height="59dp"
            android:text="NECROMANCER"
            android:textColor="@android:color/white"
            android:textStyle="bold"
            android:layout_marginBottom="12dp"/>

        <Button
            android:layout_width="250dp"
            android:layout_height="59dp"
            android:text="WITCH DOCTOR"
            android:textColor="@android:color/white"
            android:textStyle="bold"
            android:layout_marginBottom="12dp"/>

        <Button
            android:layout_width="250dp"
            android:layout_height="59dp"
            android:text="WIZARD"
            android:textColor="@android:color/white"
            android:textStyle="bold"
            android:layout_marginBottom="24dp"/>

    </LinearLayout>

    <TextView
        android:id="@+id/txtItemsTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Items"
        android:textSize="30dp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp"/>


    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:gravity="center"
        android:background="#333"
        android:orientation="horizontal"
        android:layout_alignParentBottom="true">

        <ImageButton
            android:id="@+id/btnNews"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:src="@drawable/ic_launcher_foreground"
            android:padding="14dp"
            android:contentDescription="News" />

        <ImageButton
            android:id="@+id/btnInfo"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:src="@drawable/ic_launcher_foreground"
            android:padding="14dp"
            android:backgroundTint="#CC0000"
            android:contentDescription="Info" />

        <ImageButton
            android:id="@+id/btnProfile"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:src="@drawable/ic_launcher_foreground"
            android:padding="14dp"
            android:contentDescription="Profile" />

    </LinearLayout>


</LinearLayout>

