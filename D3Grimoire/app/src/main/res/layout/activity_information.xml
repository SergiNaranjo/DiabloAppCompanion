<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingTop="32dp"
    android:background="@drawable/ic_background">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:padding="16dp">

            <TextView
                android:id="@+id/txtClassesTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/classes"
                android:textSize="30sp"
                android:textStyle="bold"
                android:textColor="?attr/colorOnSurface"
                android:layout_marginBottom="12dp"/>

            <View
                android:layout_width="180dp"
                android:layout_height="1dp"
                android:background="?attr/colorOnSurface"
                android:alpha="0.35"
                android:layout_marginBottom="20dp"/>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal">

                <FrameLayout
                    android:id="@+id/information_barbarian_button"
                    android:layout_width="match_parent"
                    android:layout_height="59dp"
                    android:layout_marginBottom="12dp"
                    android:foreground="?attr/selectableItemBackground">

                    <ImageButton
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/ic_btn_info"
                        android:clickable="false"
                        android:focusable="false" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:text="@string/barbarian"
                        android:textColor="?attr/colorOnSurface"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:clickable="false"
                        android:focusable="false" />
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/information_crusader_button"
                    android:layout_width="match_parent"
                    android:layout_height="59dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="12dp"
                    android:foreground="?attr/selectableItemBackground">

                    <ImageButton
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/ic_btn_info"
                        android:clickable="false"
                        android:focusable="false" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:text="@string/crusader"
                        android:textColor="?attr/colorOnSurface"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:clickable="false"
                        android:focusable="false" />
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/information_demon_hunter_button"
                    android:layout_width="match_parent"
                    android:layout_height="59dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="12dp"
                    android:foreground="?attr/selectableItemBackground">

                    <ImageButton
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/ic_btn_info"
                        android:clickable="false"
                        android:focusable="false" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:text="@string/demon_hunter"
                        android:textColor="?attr/colorOnSurface"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:clickable="false"
                        android:focusable="false" />
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/information_monk_button"
                    android:layout_width="match_parent"
                    android:layout_height="59dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="12dp"
                    android:foreground="?attr/selectableItemBackground">

                    <ImageButton
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/ic_btn_info"
                        android:clickable="false"
                        android:focusable="false" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:text="@string/monk"
                        android:textColor="?attr/colorOnSurface"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:clickable="false"
                        android:focusable="false" />
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/information_necromancer_button"
                    android:layout_width="match_parent"
                    android:layout_height="59dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="12dp"
                    android:foreground="?attr/selectableItemBackground">

                    <ImageButton
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/ic_btn_info"
                        android:clickable="false"
                        android:focusable="false" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:text="@string/necromancer"
                        android:textColor="?attr/colorOnSurface"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:clickable="false"
                        android:focusable="false" />
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/information_witch_doctor_button"
                    android:layout_width="match_parent"
                    android:layout_height="59dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="12dp"
                    android:foreground="?attr/selectableItemBackground">

                    <ImageButton
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/ic_btn_info"
                        android:clickable="false"
                        android:focusable="false" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:text="@string/witch_doctor"
                        android:textColor="?attr/colorOnSurface"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:clickable="false"
                        android:focusable="false" />
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/information_wizard_button"
                    android:layout_width="match_parent"
                    android:layout_height="59dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="12dp"
                    android:foreground="?attr/selectableItemBackground">

                    <ImageButton
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/ic_btn_info"
                        android:clickable="false"
                        android:focusable="false" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:text="@string/wizard"
                        android:textColor="?attr/colorOnSurface"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:clickable="false"
                        android:focusable="false" />
                </FrameLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/txtItemsTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/items"
                android:textSize="30sp"
                android:textStyle="bold"
                android:textColor="?attr/colorOnSurface"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="12dp"/>

            <View
                android:layout_width="160dp"
                android:layout_height="1dp"
                android:background="?attr/colorOnSurface"
                android:alpha="0.35"
                android:layout_marginBottom="16dp"/>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/items_recycler"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:nestedScrollingEnabled="false"
                android:paddingBottom="8dp" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</RelativeLayout>
