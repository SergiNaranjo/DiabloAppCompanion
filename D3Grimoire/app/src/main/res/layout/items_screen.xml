<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Bottom Bar SIEMPRE abajo -->
    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="#333"
        android:layout_alignParentBottom="true">

        <ImageButton
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:src="@drawable/ic_launcher_foreground" />

        <ImageButton
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:src="@drawable/ic_launcher_foreground"
            android:backgroundTint="#CC0000" />

        <ImageButton
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:src="@drawable/ic_launcher_foreground" />
    </LinearLayout>


    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/bottomBar">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Items"
            android:textSize="30dp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp"
            android:gravity="center"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Weapons"
                android:textSize="25dp"
                android:textStyle="bold"
                android:layout_marginBottom="6dp"
                android:gravity="start"
                android:layout_marginLeft="20dp"/>

            <View
                android:layout_width="200dp"
                android:layout_height="2dp"
                android:background="#AAAAAA"
                android:layout_marginBottom="24dp"
                android:layout_gravity="start" />

            <!-- Tus cards aquí -->
            <!-- (Pegué las 3 tal cual las tienes) -->

            <!-- CARD #1 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:orientation="horizontal"
                android:padding="10dp"
                android:layout_marginBottom="16dp">

                <ImageView
                    android:layout_width="90dp"
                    android:layout_height="match_parent"
                    android:scaleType="centerInside"
                    android:src="@tools:sample/avatars" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:layout_weight="1"
                    android:paddingLeft="12dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="THE BUTCHER'S CLEAVER"
                        android:textStyle="bold"
                        android:textSize="14sp" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="MAGIC AXE"
                        android:textSize="12sp"
                        android:layout_marginBottom="4dp" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="REQUIRES LEVEL: 3"
                        android:textStyle="bold"
                        android:textSize="12sp"
                        android:layout_marginBottom="6dp" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="118.3 DAMAGE PER SECOND\n+30 STRENGTH\n+20 ATTACKS PER SECOND"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- CARD #2 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:orientation="horizontal"
                android:padding="10dp"
                android:layout_marginBottom="16dp">

                <ImageView
                    android:layout_width="90dp"
                    android:layout_height="match_parent"
                    android:scaleType="centerInside"
                    android:src="@tools:sample/avatars" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:layout_weight="1"
                    android:paddingLeft="12dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="AIDAN'S REVENGE"
                        android:textStyle="bold"
                        android:textSize="14sp" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="AXE"
                        android:textSize="12sp"
                        android:layout_marginBottom="4dp" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="REQUIRES LEVEL: 1"
                        android:textStyle="bold"
                        android:textSize="12sp"
                        android:layout_marginBottom="6dp" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="10.4 DAMAGE PER SECOND\n+10 STRENGTH\n+10 ATTACKS PER SECOND"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- CARD #3 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:orientation="horizontal"
                android:padding="10dp"
                android:layout_marginBottom="16dp">

                <ImageView
                    android:layout_width="90dp"
                    android:layout_height="match_parent"
                    android:scaleType="centerInside"
                    android:src="@tools:sample/avatars" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:layout_weight="1"
                    android:paddingLeft="12dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="THE BUTCHER'S CLEAVER"
                        android:textStyle="bold"
                        android:textSize="14sp" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="MAGIC AXE"
                        android:textSize="12sp"
                        android:layout_marginBottom="4dp" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="REQUIRES LEVEL: 3"
                        android:textStyle="bold"
                        android:textSize="12sp"
                        android:layout_marginBottom="6dp" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="118.3 DAMAGE PER SECOND\n+30 STRENGTH\n+20 ATTACKS PER SECOND"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</RelativeLayout>


