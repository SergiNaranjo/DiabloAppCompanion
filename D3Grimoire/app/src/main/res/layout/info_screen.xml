<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingTop="32dp"
    android:background="#1A0F0A">

    <!-- SCROLLABLE CONTENT -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/bottomBar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:padding="16dp">

            <!-- CLASSES SECTION -->
            <TextView
                android:id="@+id/txtClassesTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Classes"
                android:textSize="30sp"
                android:textStyle="bold"
                android:textColor="@android:color/white"
                android:layout_marginBottom="16dp"/>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal">

                <Button
                    android:layout_width="250dp"
                    android:layout_height="59dp"
                    android:text="BARBARIAN"
                    android:textColor="@android:color/white"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp"
                    android:backgroundTint="#CC0000"/>

                <Button
                    android:layout_width="250dp"
                    android:layout_height="59dp"
                    android:text="CRUSADER"
                    android:textColor="@android:color/white"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp"
                    android:backgroundTint="#CC0000"/>

                <Button
                    android:layout_width="250dp"
                    android:layout_height="59dp"
                    android:text="DEMON HUNTER"
                    android:textColor="@android:color/white"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp"
                    android:backgroundTint="#CC0000"/>

                <Button
                    android:layout_width="250dp"
                    android:layout_height="59dp"
                    android:text="MONK"
                    android:textColor="@android:color/white"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp"
                    android:backgroundTint="#CC0000"/>

                <Button
                    android:layout_width="250dp"
                    android:layout_height="59dp"
                    android:text="NECROMANCER"
                    android:textColor="@android:color/white"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp"
                    android:backgroundTint="#CC0000"/>

                <Button
                    android:layout_width="250dp"
                    android:layout_height="59dp"
                    android:text="WITCH DOCTOR"
                    android:textColor="@android:color/white"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp"
                    android:backgroundTint="#CC0000"/>

                <Button
                    android:layout_width="250dp"
                    android:layout_height="59dp"
                    android:text="WIZARD"
                    android:textColor="@android:color/white"
                    android:textStyle="bold"
                    android:layout_marginBottom="24dp"
                    android:backgroundTint="#CC0000"/>
            </LinearLayout>

            <!-- ITEMS SECTION -->
            <TextView
                android:id="@+id/txtItemsTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Items"
                android:textSize="30sp"
                android:textStyle="bold"
                android:textColor="@android:color/white"
                android:layout_marginBottom="16dp"/>

            <!-- CARD #1 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:orientation="horizontal"
                android:padding="10dp"
                android:layout_marginBottom="16dp"
                android:background="#8A0D08">

                <ImageView
                    android:layout_width="90dp"
                    android:layout_height="match_parent"
                    android:scaleType="centerInside"
                    android:src="@tools:sample/avatars" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:layout_weight="1"
                    android:paddingLeft="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="THE BUTCHER'S CLEAVER"
                        android:textStyle="bold"
                        android:textSize="14sp"
                        android:textColor="@android:color/white"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="MAGIC AXE"
                        android:textSize="12sp"
                        android:layout_marginBottom="4dp"
                        android:textColor="@android:color/white"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="REQUIRES LEVEL: 3"
                        android:textStyle="bold"
                        android:textSize="12sp"
                        android:layout_marginBottom="6dp"
                        android:textColor="@android:color/white"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="118.3 DAMAGE PER SECOND\n+30 STRENGTH\n+20 ATTACKS PER SECOND"
                        android:textSize="11sp"
                        android:textColor="@android:color/white"/>
                </LinearLayout>
            </LinearLayout>

            <!-- CARD #2 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:orientation="horizontal"
                android:padding="10dp"
                android:layout_marginBottom="16dp"
                android:background="#8A0D08">

                <ImageView
                    android:layout_width="90dp"
                    android:layout_height="match_parent"
                    android:scaleType="centerInside"
                    android:src="@tools:sample/avatars" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:layout_weight="1"
                    android:paddingLeft="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="AIDAN'S REVENGE"
                        android:textStyle="bold"
                        android:textSize="14sp"
                        android:textColor="@android:color/white"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="AXE"
                        android:textSize="12sp"
                        android:layout_marginBottom="4dp"
                        android:textColor="@android:color/white"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="REQUIRES LEVEL: 1"
                        android:textStyle="bold"
                        android:textSize="12sp"
                        android:layout_marginBottom="6dp"
                        android:textColor="@android:color/white"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="10.4 DAMAGE PER SECOND\n+10 STRENGTH\n+10 ATTACKS PER SECOND"
                        android:textSize="11sp"
                        android:textColor="@android:color/white"/>
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- BOTTOM BAR -->
    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="#333"
        android:layout_alignParentBottom="true">

        <ImageButton
            android:id="@+id/btnNews"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:src="@drawable/ic_launcher_foreground"
            android:padding="14dp"
            android:contentDescription="News" />

        <ImageButton
            android:id="@+id/btnInfo"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:src="@drawable/ic_launcher_foreground"
            android:padding="14dp"
            android:backgroundTint="#CC0000"
            android:contentDescription="Info" />

        <ImageButton
            android:id="@+id/btnProfile"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:src="@drawable/ic_launcher_foreground"
            android:padding="14dp"
            android:contentDescription="Profile" />
    </LinearLayout>

</RelativeLayout>


