<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingTop="32dp"
    android:background="@drawable/ic_background">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:padding="16dp">

            <TextView
                android:id="@+id/txtClassesTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Classes"
                android:textSize="30sp"
                android:textStyle="bold"
                android:textColor="@android:color/white"
                android:layout_marginBottom="16dp"/>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal">

                <!--FrameLayout from ChatGPT because didn't know how to show background and text both in a button -->
                <FrameLayout
                    android:layout_width="250dp"
                    android:layout_height="59dp"
                    android:layout_marginBottom="12dp">

                    <ImageButton
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/ic_btn_info"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:text="BARBARIAN"
                        android:textColor="@android:color/white"
                        android:textStyle="bold"
                        android:gravity="center"/>
                </FrameLayout>

                <FrameLayout
                    android:layout_width="250dp"
                    android:layout_height="59dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="12dp">

                    <ImageButton
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/ic_btn_info"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:text="CRUSADER"
                        android:textColor="@android:color/white"
                        android:textStyle="bold"
                        android:gravity="center"/>
                </FrameLayout>

                <FrameLayout
                    android:layout_width="250dp"
                    android:layout_height="59dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="12dp">

                    <ImageButton
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/ic_btn_info"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:text="DEMON HUNTER"
                        android:textColor="@android:color/white"
                        android:textStyle="bold"
                        android:gravity="center"/>
                </FrameLayout>

                <FrameLayout
                    android:layout_width="250dp"
                    android:layout_height="59dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="12dp">

                    <ImageButton
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/ic_btn_info"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:text="MONK"
                        android:textColor="@android:color/white"
                        android:textStyle="bold"
                        android:gravity="center"/>
                </FrameLayout>

                <FrameLayout
                    android:layout_width="250dp"
                    android:layout_height="59dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="12dp">

                    <ImageButton
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/ic_btn_info"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:text="NECROMANCER"
                        android:textColor="@android:color/white"
                        android:textStyle="bold"
                        android:gravity="center"/>
                </FrameLayout>

                <FrameLayout
                    android:layout_width="250dp"
                    android:layout_height="59dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="12dp">

                    <ImageButton
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/ic_btn_info"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:text="WITCH DOCTOR"
                        android:textColor="@android:color/white"
                        android:textStyle="bold"
                        android:gravity="center"/>
                </FrameLayout>
                <FrameLayout
                    android:layout_width="250dp"
                    android:layout_height="59dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="12dp">

                    <ImageButton
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/ic_btn_info"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:text="WIZARD"
                        android:textColor="@android:color/white"
                        android:textStyle="bold"
                        android:gravity="center"/>
                </FrameLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/txtItemsTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Items"
                android:textSize="30sp"
                android:textStyle="bold"
                android:textColor="@android:color/white"
                android:layout_marginBottom="16dp"/>

            <androidx.fragment.app.FragmentContainerView
                android:id="@+id/item_0"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"/>

            <androidx.fragment.app.FragmentContainerView
                android:id="@+id/item_1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"/>

        </LinearLayout>
    </ScrollView>
</RelativeLayout>


